;
; bitggvad.inx - BitGG Virtual Audio
;
; Root-enumerated virtual audio device with five render endpoints
; (Game, Chat, Media, Aux, Mic (in)) and one capture endpoint (Mic).
; No APO / effects are registered. See docs/driver/SPEC.md.
;

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 01/01/2026,0.1.0.0
CatalogFile = bitggvad.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
bitggvad.sys = 1

[DestinationDirs]
BitGG.CopyList = 13 ; driver store

[Manufacturer]
%MfgName% = BitGG, NT$ARCH$.10.0...19041

[BitGG.NT$ARCH$.10.0...19041]
%BitGG.DeviceDesc% = BitGG_Device, ROOT\BitGG_VirtualAudio

;------------------------------------------------------------------------------
; Install
;------------------------------------------------------------------------------
[BitGG_Device.NT]
Include  = ks.inf, wdmaudio.inf
Needs    = KS.Registration, WDMAUDIO.Registration
CopyFiles = BitGG.CopyList
AddReg   = BitGG.AddReg

[BitGG.CopyList]
bitggvad.sys

[BitGG.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,bitggvad.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%BitGG.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%BitGG.DeviceDesc%
; Endpoint names shown in Sound settings.
HKR,%MediaCategories%\%BitGG.Name.Game%,Name,,%BitGG.Game%
HKR,%MediaCategories%\%BitGG.Name.Chat%,Name,,%BitGG.Chat%
HKR,%MediaCategories%\%BitGG.Name.Media%,Name,,%BitGG.Media%
HKR,%MediaCategories%\%BitGG.Name.Aux%,Name,,%BitGG.Aux%
HKR,%MediaCategories%\%BitGG.Name.MicIn%,Name,,%BitGG.MicIn%
HKR,%MediaCategories%\%BitGG.Name.Mic%,Name,,%BitGG.Mic%

[BitGG_Device.NT.HW]
AddReg = BitGG.HW.AddReg

[BitGG.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[BitGG_Device.NT.Services]
AddService = bitggvad, 0x00000002, BitGG.Service

[BitGG.Service]
DisplayName   = %BitGG.SvcDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\bitggvad.sys

[BitGG_Device.NT.Wdf]
KmdfService = bitggvad, BitGG.WdfSect

[BitGG.WdfSect]
KmdfLibraryVersion = $KMDFVERSION$

;------------------------------------------------------------------------------
; Filter interfaces. Reference strings must match the names in minipairs.h.
;------------------------------------------------------------------------------
[BitGG_Device.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveGame%,      BitGG.I.WaveGame
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveGame%,      BitGG.I.WaveGame
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveGame%,      BitGG.I.WaveGame
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyGame%,  BitGG.I.TopologyGame
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyGame%,  BitGG.I.TopologyGame

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveChat%,      BitGG.I.WaveChat
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveChat%,      BitGG.I.WaveChat
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveChat%,      BitGG.I.WaveChat
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyChat%,  BitGG.I.TopologyChat
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyChat%,  BitGG.I.TopologyChat

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMedia%,     BitGG.I.WaveMedia
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveMedia%,     BitGG.I.WaveMedia
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMedia%,     BitGG.I.WaveMedia
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMedia%, BitGG.I.TopologyMedia
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMedia%, BitGG.I.TopologyMedia

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveAux%,       BitGG.I.WaveAux
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveAux%,       BitGG.I.WaveAux
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveAux%,       BitGG.I.WaveAux
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyAux%,   BitGG.I.TopologyAux
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyAux%,   BitGG.I.TopologyAux

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMicIn%,     BitGG.I.WaveMicIn
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveMicIn%,     BitGG.I.WaveMicIn
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMicIn%,     BitGG.I.WaveMicIn
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMicIn%, BitGG.I.TopologyMicIn
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicIn%, BitGG.I.TopologyMicIn

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveMic%,       BitGG.I.WaveMic
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveMic%,       BitGG.I.WaveMic
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveMic%,       BitGG.I.WaveMic
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyMic%,   BitGG.I.TopologyMic
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMic%,   BitGG.I.TopologyMic

; Wave filters
[BitGG.I.WaveGame]
AddReg = BitGG.I.WaveGame.AddReg
[BitGG.I.WaveGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Game%

[BitGG.I.WaveChat]
AddReg = BitGG.I.WaveChat.AddReg
[BitGG.I.WaveChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Chat%

[BitGG.I.WaveMedia]
AddReg = BitGG.I.WaveMedia.AddReg
[BitGG.I.WaveMedia.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Media%

[BitGG.I.WaveAux]
AddReg = BitGG.I.WaveAux.AddReg
[BitGG.I.WaveAux.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Aux%

[BitGG.I.WaveMicIn]
AddReg = BitGG.I.WaveMicIn.AddReg
[BitGG.I.WaveMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.MicIn%

[BitGG.I.WaveMic]
AddReg = BitGG.I.WaveMic.AddReg
[BitGG.I.WaveMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Mic%

; Topology filters: endpoint properties live here. No FX keys = no APO.
[BitGG.I.TopologyGame]
AddReg = BitGG.I.TopologyGame.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyGame.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Game%

[BitGG.I.TopologyChat]
AddReg = BitGG.I.TopologyChat.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyChat.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Chat%

[BitGG.I.TopologyMedia]
AddReg = BitGG.I.TopologyMedia.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyMedia.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Media%

[BitGG.I.TopologyAux]
AddReg = BitGG.I.TopologyAux.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyAux.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Aux%

[BitGG.I.TopologyMicIn]
AddReg = BitGG.I.TopologyMicIn.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.MicIn%

[BitGG.I.TopologyMic]
AddReg = BitGG.I.TopologyMic.AddReg, BitGG.Endpoint.AddReg
[BitGG.I.TopologyMic.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%BitGG.Mic%

[BitGG.Endpoint.AddReg]
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

;------------------------------------------------------------------------------
[Strings]
ProviderName      = "BitGG"
MfgName           = "BitGG"
DiskName          = "BitGG Virtual Audio Install Disk"
BitGG.DeviceDesc  = "BitGG Virtual Audio"
BitGG.SvcDesc     = "BitGG Virtual Audio Driver"

BitGG.Game        = "BitGG Game"
BitGG.Chat        = "BitGG Chat"
BitGG.Media       = "BitGG Media"
BitGG.Aux         = "BitGG Aux"
BitGG.MicIn       = "BitGG Mic (in)"
BitGG.Mic         = "BitGG Mic"

; Endpoint name GUIDs (bitggtoptable.h, micintoptable.h)
BitGG.Name.Game   = "{95663dfc-3d84-4530-b8cb-c3a1e3408f36}"
BitGG.Name.Chat   = "{62c8d2d0-a743-4bd9-91ea-9dda985554b8}"
BitGG.Name.Media  = "{57732222-9ac1-4675-b00f-8353282ad9fc}"
BitGG.Name.Aux    = "{59e39824-e65b-4638-bfe5-0947c0d7f066}"
BitGG.Name.MicIn  = "{7dca001f-cdb5-404e-956a-28dc496aefc0}"
BitGG.Name.Mic    = "{496f0aa1-3614-4027-b3bc-28ac2f3c66e0}"

KSNAME_WaveGame       = "WaveGame"
KSNAME_TopologyGame   = "TopologyGame"
KSNAME_WaveChat       = "WaveChat"
KSNAME_TopologyChat   = "TopologyChat"
KSNAME_WaveMedia      = "WaveMedia"
KSNAME_TopologyMedia  = "TopologyMedia"
KSNAME_WaveAux        = "WaveAux"
