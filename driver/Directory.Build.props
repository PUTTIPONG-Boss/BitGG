<Project>
  <!-- WDK + SDK from NuGet (run `nuget restore packages.config -PackagesDirectory packages` in this folder). -->
  <PropertyGroup>
    <BitggWdkVersion>10.0.28000.2526</BitggWdkVersion>
    <BitggPackages>$(MSBuildThisFileDirectory)packages\</BitggPackages>
  </PropertyGroup>
  <Import Project="$(BitggPackages)Microsoft.Windows.WDK.x64.$(BitggWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(BitggPackages)Microsoft.Windows.WDK.x64.$(BitggWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(BitggPackages)Microsoft.Windows.SDK.CPP.x64.$(BitggWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(BitggPackages)Microsoft.Windows.SDK.CPP.x64.$(BitggWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(BitggPackages)Microsoft.Windows.SDK.CPP.$(BitggWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(BitggPackages)Microsoft.Windows.SDK.CPP.$(BitggWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
